generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                 String              @id @default(uuid())
  legalName          String
  displayName        String
  createdAt          DateTime            @default(now())
  locations          Location[]
  memberships        StaffMembership[]
  owners             Owner[]
  pets               Pet[]
  audits             AuditEvent[]
  outbox             OutboxEvent[]
  surgicalCases      SurgicalCase[]
  anesthesiaRecords  AnesthesiaRecord[]
  dentalCharts       DentalChart[]
  equipment          Equipment[]
  physicalIdentities PhysicalIdentity[]
  labOrders          LabOrder[]
  specimens          Specimen[]
  suppliers          Supplier[]
  purchaseOrders     PurchaseOrder[]
  printTemplates     PrintTemplate[]
  printJobs          PrintJob[]
  checklistTemplates ChecklistTemplate[]
  checklistRuns      ChecklistRun[]
  staffProfiles      StaffProfile[]
  credentials        Credential[]
  prechecks          Precheck[]
  hospitalBeds       HospitalBed[]
  hospitalizations   Hospitalization[]
  inventoryItems     InventoryItem[]
  stockLots          StockLot[]
  stockMovements     StockMovement[]
}

model Location {
  id             String          @id @default(uuid())
  organizationId String
  name           String
  timezone       String
  active         Boolean         @default(true)
  bookingCapacity Int            @default(3)
  workingHours    Json           @default("{}")
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  equipment      Equipment[]
  hospitalBeds   HospitalBed[]
  stockLots      StockLot[]
  stockMovements StockMovement[]

  @@index([organizationId])
}

model UserIdentity {
  id                String            @id @default(uuid())
  login             String?           @unique
  phone             String?           @unique
  email             String?           @unique
  telegramUserId    String?           @unique
  passwordHash      String?
  passwordUpdatedAt DateTime?
  createdAt         DateTime          @default(now())
  memberships       StaffMembership[]
  sessions          AuthSession[]
  owners            Owner[]
}

model AuthOtpChallenge {
  id        String   @id @default(uuid())
  identity  String
  purpose   String
  codeHash  String
  attempts  Int      @default(0)
  state     String   @default("PENDING")
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([identity, state, expiresAt])
}

model AuthSession {
  id          String       @id @default(uuid())
  userId      String
  tokenHash   String       @unique
  deviceLabel String?
  mode        String       @default("CLIENT")
  state       String       @default("ACTIVE")
  createdAt   DateTime     @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?
  user        UserIdentity @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, state, expiresAt])
}

model TelegramLoginRequest {
  id             String    @id @default(uuid())
  tokenHash      String    @unique
  state          String    @default("PENDING")
  mode           String    @default("CLIENT")
  staffInviteId  String?
  targetUserId   String?
  telegramUserId String?
  chatId         String?
  expiresAt      DateTime
  confirmedAt    DateTime?
  consumedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([state, expiresAt])
  @@index([telegramUserId])
  @@index([staffInviteId, state])
  @@index([targetUserId, state])
}

model TelegramConversation {
  id             String   @id @default(uuid())
  organizationId String
  telegramUserId String
  chatId         String
  state          String
  data           Json     @default("{}")
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, telegramUserId])
  @@index([organizationId, state, expiresAt])
}

model StaffInvite {
  id               String    @id @default(uuid())
  organizationId   String
  tokenHash        String    @unique
  fullName         String
  role             String
  state            String    @default("PENDING")
  expiresAt        DateTime
  acceptedAt       DateTime?
  acceptedByUserId String?
  createdAt        DateTime  @default(now())

  @@index([organizationId, state, expiresAt])
}

model TelegramAdminChat {
  id             String   @id @default(uuid())
  singletonKey   String   @unique
  chatId         String   @unique
  telegramUserId String   @unique
  createdAt      DateTime @default(now())
}

model AdminEnrollment {
  id             String    @id @default(uuid())
  tokenHash      String    @unique
  label          String
  state          String    @default("PENDING")
  expiresAt      DateTime
  consumedAt     DateTime?
  telegramUserId String?
  createdAt      DateTime  @default(now())

  @@index([state, expiresAt])
}

model TelegramRequest {
  id             String                @id @default(uuid())
  telegramUserId String
  chatId         String
  kind           String
  message        String
  state          String
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  paymentProof   TelegramPaymentProof?

  @@index([telegramUserId, state, createdAt])
}

model TelegramPaymentProof {
  id               String           @id @default(uuid())
  requestId        String?          @unique
  consultationId   String?          @unique
  appointmentId    String?          @unique
  telegramUserId   String
  chatId           String
  sourceMessageId  Int
  purpose          String
  state            String           @default("PENDING_REVIEW")
  reviewedByChatId String?
  reviewedAt       DateTime?
  reviewNote       String?
  createdAt        DateTime         @default(now())
  request          TelegramRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  consultation     Consultation?    @relation(fields: [consultationId], references: [id], onDelete: SetNull)
  appointment      Appointment?     @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([state, createdAt])
  @@index([telegramUserId, chatId])
}

model StaffMembership {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  role           String
  state          String       @default("ACTIVE")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           UserIdentity @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId])
  @@index([organizationId, role])
}

model Owner {
  id               String             @id @default(uuid())
  organizationId   String
  userId           String?
  fullName         String
  phone            String?
  email            String?
  telegramUserId   String?
  preferredChannel String             @default("TELEGRAM")
  address          String?
  emergencyContact String?
  marketingConsent Boolean            @default(false)
  accountStatus    String             @default("ACTIVE")
  tags             Json               @default("[]")
  source           String?
  utm              Json               @default("{}")
  notes            String?
  createdIdempotencyKey String?        @unique
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @default(now()) @updatedAt
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user             UserIdentity?      @relation(fields: [userId], references: [id], onDelete: Restrict)
  relations        OwnerPetRelation[]
  invoices         Invoice[]
  consultations    Consultation[]
  hospitalizations Hospitalization[]
  consents         Consent[]
  surgicalCases    SurgicalCase[]
  dentalCharts     DentalChart[]
  files            PetFile[]

  @@unique([organizationId, telegramUserId])
  @@unique([organizationId, userId])
  @@index([organizationId, phone])
}

model Pet {
  id               String             @id @default(uuid())
  organizationId   String
  name             String
  species          String
  breed            String?
  sex              String?
  neuterState      String?
  birthDate        DateTime?
  color            String?
  microchip        String?
  passportId       String?
  lifecycle        String             @default("ACTIVE")
  medicalAlerts    Json?
  chronicConditions Json              @default("[]")
  behavioralAlerts Json               @default("[]")
  feedingNotes      String?
  medicationNotes   String?
  vaccinationDueAt DateTime?
  primaryVeterinarianId String?
  createdIdempotencyKey String?        @unique
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @default(now()) @updatedAt
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  relations        OwnerPetRelation[]
  cases            ClinicalCase[]
  surgicalCases    SurgicalCase[]
  dentalCharts     DentalChart[]
  labOrders        LabOrder[]
  consultations    Consultation[]
  hospitalizations Hospitalization[]
  specimens        Specimen[]
  files            PetFile[]

  @@index([organizationId, name])
}

model OwnerPetRelation {
  id             String  @id @default(uuid())
  organizationId String
  ownerId        String
  petId          String
  relation       String
  primary        Boolean @default(false)
  permissions    Json    @default("[\"VIEW\",\"BOOK\"]")
  state          String  @default("ACTIVE")
  createdAt      DateTime @default(now())
  endedAt        DateTime?
  owner          Owner   @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  pet            Pet     @relation(fields: [petId], references: [id], onDelete: Restrict)

  @@unique([organizationId, ownerId, petId])
  @@index([organizationId, petId, state])
}

model PetFile {
  id             String   @id @default(uuid())
  organizationId String
  ownerId        String?
  petId          String
  category       String
  originalName   String
  mimeType       String
  sizeBytes      Int
  contentHash    String
  storageKey     String   @unique
  state          String   @default("ACTIVE")
  uploadedBy     String
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())
  archivedAt     DateTime?
  owner          Owner?   @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  pet            Pet      @relation(fields: [petId], references: [id], onDelete: Restrict)

  @@index([organizationId, petId, state, createdAt])
}

model Service {
  id             String           @id @default(uuid())
  organizationId String
  publicName     String
  internalName   String
  kind           String
  onlineBookable Boolean          @default(true)
  variants       ServiceVariant[]

  @@index([organizationId, kind])
}

model ServiceVariant {
  id                  String  @id @default(uuid())
  organizationId      String
  serviceId           String
  name                String
  durationMinutes     Int
  bufferBeforeMinutes Int     @default(0)
  bufferAfterMinutes  Int     @default(0)
  priceMinor          Int
  depositMinor        Int     @default(0)
  currency            String  @default("RUB")
  allowedSpecies      Json
  service             Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([organizationId, serviceId])
}

model Appointment {
  id              String           @id @default(uuid())
  organizationId  String
  locationId      String
  ownerId         String
  petId           String
  variantId       String
  staffId         String
  startsAt        DateTime
  endsAt          DateTime
  state           String
  createdAt       DateTime         @default(now())
  consultation    Consultation?
  encounter       Encounter?
  hospitalization Hospitalization?
  paymentProof    TelegramPaymentProof?

  @@index([organizationId, staffId, startsAt])
  @@index([organizationId, petId, startsAt])
}

model Consultation {
  id                    String                @id @default(uuid())
  organizationId        String
  ownerId               String
  petId                 String
  appointmentId         String                @unique
  question              String
  preferredChannel      String                @default("TELEGRAM")
  state                 String                @default("WAITING_PAYMENT")
  paymentState          String                @default("AWAITING_PROOF")
  paymentTokenHash      String                @unique
  paymentTokenExpiresAt DateTime
  telegramUserId        String?
  telegramChatId        String?
  staffId               String?
  response              String?
  respondedAt           DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  owner                 Owner                 @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  pet                   Pet                   @relation(fields: [petId], references: [id], onDelete: Restrict)
  appointment           Appointment           @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  paymentProof          TelegramPaymentProof?

  @@index([organizationId, ownerId, state, createdAt])
  @@index([organizationId, petId, createdAt])
  @@index([organizationId, paymentState, createdAt])
}

model Invoice {
  id             String              @id @default(uuid())
  organizationId String
  ownerId        String
  appointmentId  String?             @unique
  state          String
  totalMinor     Int
  paidMinor      Int                 @default(0)
  currency       String              @default("RUB")
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @default(now()) @updatedAt
  issuedAt       DateTime?
  dueAt          DateTime?
  owner          Owner               @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  lines          InvoiceLine[]
  payments       Payment[]
  fiscalReceipts FiscalReceipt[]
  documents      GeneratedDocument[]

  @@index([organizationId, ownerId])
}

model InvoiceLine {
  id             String   @id @default(uuid())
  organizationId String
  invoiceId      String
  lineType       String
  referenceId    String?
  description    String
  quantityMilli  Int      @default(1000)
  unitPriceMinor Int
  discountMinor  Int      @default(0)
  totalMinor     Int
  taxCode        String?
  performerId    String?
  costBasisMinor Int?
  idempotencyKey String?  @unique
  createdAt      DateTime @default(now())
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([organizationId, invoiceId, createdAt])
  @@index([organizationId, referenceId])
}

model Payment {
  id                    String          @id @default(uuid())
  organizationId        String
  invoiceId             String
  provider              String
  providerTransactionId String
  amountMinor           Int
  currency              String
  state                 String
  method                String          @default("MANUAL")
  confirmedAt           DateTime?
  createdAt             DateTime        @default(now())
  invoice               Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  fiscalReceipts        FiscalReceipt[]

  @@unique([organizationId, provider, providerTransactionId])
}

model FiscalReceipt {
  id             String   @id @default(uuid())
  organizationId String
  invoiceId      String
  paymentId      String?
  receiptType    String   @default("PAYMENT")
  state          String   @default("PENDING_PROVIDER")
  provider       String?
  externalId     String?
  idempotencyKey String   @unique
  failureReason  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  payment        Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([organizationId, state, createdAt])
  @@index([organizationId, invoiceId])
}

model ClinicalCase {
  id             String      @id @default(uuid())
  organizationId String
  ownerId        String
  petId          String
  status         String
  reason         String
  openedAt       DateTime    @default(now())
  pet            Pet         @relation(fields: [petId], references: [id], onDelete: Restrict)
  encounters     Encounter[]

  @@index([organizationId, petId, openedAt])
}

model Encounter {
  id             String         @id @default(uuid())
  organizationId String
  caseId         String
  appointmentId  String?        @unique
  petId          String
  version        Int
  state          String
  subjective     String?
  objective      String?
  assessment     String?
  plan           String?
  clinicianId    String
  finalizedAt    DateTime?
  amendmentOfId  String?
  clinicalCase   ClinicalCase   @relation(fields: [caseId], references: [id], onDelete: Restrict)
  appointment    Appointment?   @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  prescriptions  Prescription[]

  @@unique([caseId, version])
  @@index([organizationId, petId])
}

model Prescription {
  id             String    @id @default(uuid())
  organizationId String
  encounterId    String
  medicationName String
  instructions   String
  state          String
  prescriberId   String
  encounter      Encounter @relation(fields: [encounterId], references: [id], onDelete: Restrict)

  @@index([organizationId, encounterId])
}

model Consent {
  id              String             @id @default(uuid())
  organizationId  String
  ownerId         String
  petId           String?
  documentId      String?            @unique
  appointmentId   String?
  caseId          String?
  documentVersion String
  purpose         String
  state           String
  signerName      String?
  source          String             @default("WEB")
  proofMetadata   Json?
  signedAt        DateTime
  revokedAt       DateTime?
  createdAt       DateTime           @default(now())
  idempotencyKey  String?            @unique
  owner           Owner              @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  document        GeneratedDocument? @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@index([organizationId, ownerId])
  @@index([organizationId, petId, purpose])
}

model CarePlan {
  id             String         @id @default(uuid())
  organizationId String
  ownerId        String
  petId          String
  title          String
  state          String
  createdAt      DateTime       @default(now())
  tasks          CarePlanTask[]

  @@index([organizationId, petId])
}

model CarePlanTask {
  id             String    @id @default(uuid())
  carePlanId     String
  organizationId String
  title          String
  category       String
  dueAt          DateTime?
  state          String
  completedAt    DateTime?
  carePlan       CarePlan  @relation(fields: [carePlanId], references: [id], onDelete: Restrict)

  @@index([organizationId, dueAt, state])
}

model GroomingProfile {
  id             String   @id @default(uuid())
  organizationId String
  petId          String
  coatType       String?
  sensitivities  String?
  behaviorNotes  String?
  preferredStyle String?
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  @@unique([organizationId, petId])
  @@index([organizationId, petId])
}

model GroomingRecipe {
  id             String   @id @default(uuid())
  organizationId String
  petId          String
  title          String
  steps          Json
  notes          String?
  isPreferred    Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([organizationId, petId, isPreferred])
}

model GroomingVisit {
  id             String    @id @default(uuid())
  organizationId String
  appointmentId  String    @unique
  petId          String
  recipeId       String?
  state          String
  currentStage   String    @default("INTAKE")
  stageStartedAt DateTime  @default(now())
  stageLog       Json      @default("[]")
  checklist      Json      @default("[]")
  report         String?
  homeCare       Json      @default("[]")
  nextCareAt     DateTime?
  beforeFileIds  Json      @default("[]")
  afterFileIds   Json      @default("[]")
  startedBy      String
  completedBy    String?
  completedAt    DateTime?
  updatedAt      DateTime  @updatedAt
  createdAt      DateTime  @default(now())

  @@index([organizationId, petId, state])
}

model PassportShare {
  id             String   @id @default(uuid())
  organizationId String
  ownerId        String
  petId          String
  token          String   @unique
  scope          String
  state          String
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  @@index([organizationId, petId, state])
}

model PrivacyRequest {
  id             String    @id @default(uuid())
  organizationId String
  ownerId        String
  type           String
  state          String
  requestedAt    DateTime  @default(now())
  completedAt    DateTime?

  @@index([organizationId, ownerId, state])
}

model KnowledgeArticle {
  id             String    @id @default(uuid())
  organizationId String
  title          String
  slug           String
  body           String
  state          String
  reviewedBy     String?
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())

  @@unique([organizationId, slug])
}

model ServicePackage {
  id             String           @id @default(uuid())
  organizationId String
  name           String
  description    String?
  credits        Int
  priceMinor     Int              @default(0)
  currency       String           @default("RUB")
  validityDays   Int              @default(365)
  familyShared   Boolean          @default(false)
  benefits       Json             @default("{}")
  state          String
  serviceIds     Json
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @default(now()) @updatedAt
  balances       PackageBalance[]

  @@index([organizationId, state])
}

model PackageBalance {
  id               String         @id @default(uuid())
  organizationId   String
  ownerId          String
  petId            String?
  packageId        String
  invoiceId        String?
  initialCredits   Int            @default(0)
  remainingCredits Int
  state            String         @default("PENDING_PAYMENT")
  purchasedAt      DateTime       @default(now())
  activatedAt      DateTime?
  expiresAt        DateTime?
  idempotencyKey   String?        @unique
  servicePackage   ServicePackage @relation(fields: [packageId], references: [id], onDelete: Restrict)
  usages           PackageUsage[]

  @@index([organizationId, ownerId])
  @@index([organizationId, state, expiresAt])
}

model PackageUsage {
  id             String         @id @default(uuid())
  organizationId String
  balanceId      String
  appointmentId  String         @unique
  variantId      String
  creditsUsed    Int            @default(1)
  usedBy         String
  usedAt         DateTime       @default(now())
  balance        PackageBalance @relation(fields: [balanceId], references: [id], onDelete: Restrict)

  @@index([organizationId, balanceId, usedAt])
}

model LoyaltyPolicy {
  id                 String   @id @default(uuid())
  organizationId     String
  name               String
  pointsPer100Rubles Int      @default(1)
  rublesPerPoint     Int      @default(1)
  tiers              Json     @default("[]")
  state              String   @default("ACTIVE")
  version            Int      @default(1)
  effectiveAt        DateTime @default(now())
  createdAt          DateTime @default(now())

  @@unique([organizationId, version])
  @@index([organizationId, state, effectiveAt])
}

model LoyaltyLedgerEntry {
  id             String   @id @default(uuid())
  organizationId String
  ownerId        String
  pointsDelta    Int
  balanceAfter   Int      @default(0)
  reason         String
  referenceType  String?
  referenceId    String?
  idempotencyKey String?  @unique
  createdAt      DateTime @default(now())

  @@index([organizationId, ownerId, createdAt])
  @@index([organizationId, referenceType, referenceId])
}

model MembershipPlan {
  id                String            @id @default(uuid())
  organizationId    String
  name              String
  description       String?
  priceMinor        Int
  currency          String            @default("RUB")
  billingPeriodDays Int               @default(30)
  benefits          Json              @default("{}")
  serviceLimits     Json              @default("{}")
  state             String            @default("ACTIVE")
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @default(now()) @updatedAt
  memberships       OwnerMembership[]

  @@index([organizationId, state])
}

model OwnerMembership {
  id                 String         @id @default(uuid())
  organizationId     String
  ownerId            String
  planId             String
  invoiceId          String?
  state              String         @default("PENDING_PAYMENT")
  autoRenew          Boolean        @default(false)
  startedAt          DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  renewsAt           DateTime?
  pausedAt           DateTime?
  cancelledAt        DateTime?
  idempotencyKey     String?        @unique
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @default(now()) @updatedAt
  plan               MembershipPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([organizationId, ownerId, state])
  @@index([organizationId, renewsAt, state])
}

model OperationalTask {
  id             String    @id @default(uuid())
  organizationId String
  title          String
  kind           String    @default("GENERAL")
  priority       String
  state          String
  assigneeId     String?
  ownerId        String?
  petId          String?
  dueAt          DateTime?
  details        String?
  relatedType    String?
  relatedId      String?
  idempotencyKey String?   @unique
  createdAt      DateTime  @default(now())
  completedAt    DateTime?

  @@index([organizationId, state, priority])
  @@index([organizationId, ownerId, state, dueAt])
  @@index([organizationId, petId, state, dueAt])
}

model CommunicationLog {
  id               String   @id @default(uuid())
  organizationId   String
  ownerId           String
  petId             String?
  channel           String
  direction         String
  kind              String
  subject           String?
  body              String
  state             String   @default("LOGGED")
  staffId           String?
  externalMessageId String?
  idempotencyKey    String?  @unique
  createdAt         DateTime @default(now())

  @@index([organizationId, ownerId, createdAt])
  @@index([organizationId, petId, createdAt])
  @@index([organizationId, channel, state, createdAt])
}

model Incident {
  id             String   @id @default(uuid())
  organizationId String
  petId          String?
  type           String
  severity       String
  description    String
  state          String
  createdAt      DateTime @default(now())

  @@index([organizationId, state, severity])
}

model Hospitalization {
  id                     String                @id @default(uuid())
  organizationId         String
  ownerId                String
  petId                  String
  appointmentId          String?               @unique
  bedId                  String?
  responsibleClinicianId String?
  acuity                 String                @default("STABLE")
  currentPlan            String?
  ownerUpdateState       String                @default("DUE")
  alerts                 Json                  @default("[]")
  state                  String
  admittedAt             DateTime              @default(now())
  dischargedAt           DateTime?
  dischargedBy           String?
  dischargeSummary       String?
  updatedAt              DateTime              @updatedAt
  tasks                  TreatmentTask[]
  observations           HospitalObservation[]
  organization           Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  owner                  Owner                 @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  pet                    Pet                   @relation(fields: [petId], references: [id], onDelete: Restrict)
  appointment            Appointment?          @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  bed                    HospitalBed?          @relation(fields: [bedId], references: [id], onDelete: Restrict)

  @@index([organizationId, petId, state])
  @@index([organizationId, bedId, state])
}

model HospitalBed {
  id               String            @id @default(uuid())
  organizationId   String
  locationId       String
  label            String
  zone             String
  state            String            @default("AVAILABLE")
  cleaningState    String            @default("READY")
  isolation        Boolean           @default(false)
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  location         Location          @relation(fields: [locationId], references: [id], onDelete: Restrict)
  hospitalizations Hospitalization[]

  @@unique([organizationId, locationId, label])
  @@index([organizationId, state, cleaningState])
}

model TreatmentTask {
  id                String          @id @default(uuid())
  hospitalizationId String
  organizationId    String
  title             String
  taskType          String          @default("TREATMENT")
  instructions      String?
  scheduledAt       DateTime
  state             String
  assignedStaffId   String?
  administeredBy    String?
  administeredAt    DateTime?
  missedReason      String?
  notes             String?
  vitals            Json?
  hospitalization   Hospitalization @relation(fields: [hospitalizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, scheduledAt, state])
}

model HospitalObservation {
  id                String          @id @default(uuid())
  hospitalizationId String
  organizationId    String
  acuity            String
  vitals            Json
  note              String?
  recordedBy        String
  recordedAt        DateTime        @default(now())
  hospitalization   Hospitalization @relation(fields: [hospitalizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, hospitalizationId, recordedAt])
}

model HospitalHandoff {
  id             String   @id @default(uuid())
  organizationId String
  summary        String
  unresolved     Json     @default("[]")
  state          String   @default("APPROVED")
  createdBy      String
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
}

model SurgicalCase {
  id                String             @id @default(uuid())
  organizationId    String
  ownerId           String
  petId             String
  procedure         String
  indication        String
  surgeonId         String
  teamIds           Json
  room              String
  scheduledAt       DateTime
  state             String
  consentRecorded   Boolean            @default(false)
  fastingConfirmed  Boolean            @default(false)
  checklist         Json
  operativeNote     String?
  complicationNote  String?
  recoveryNote      String?
  dischargedAt      DateTime?
  createdAt         DateTime           @default(now())
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  owner             Owner              @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  pet               Pet                @relation(fields: [petId], references: [id], onDelete: Restrict)
  anesthesiaRecords AnesthesiaRecord[]

  @@index([organizationId, state, scheduledAt])
  @@index([organizationId, petId, scheduledAt])
}

model AnesthesiaRecord {
  id                 String       @id @default(uuid())
  organizationId     String
  surgicalCaseId     String
  petId              String
  responsibleStaffId String
  state              String
  preAssessment      String?
  protocol           String?
  airway             String?
  medications        Json
  vitals             Json
  events             Json
  createdAt          DateTime     @default(now())
  closedAt           DateTime?
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  surgicalCase       SurgicalCase @relation(fields: [surgicalCaseId], references: [id], onDelete: Restrict)

  @@index([organizationId, surgicalCaseId])
  @@index([organizationId, petId, state])
}

model DentalChart {
  id             String       @id @default(uuid())
  organizationId String
  ownerId        String
  petId          String
  version        Int
  state          String
  findings       Json
  procedures     Json
  clinicianId    String
  createdAt      DateTime     @default(now())
  finalizedAt    DateTime?
  amendmentOfId  String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  owner          Owner        @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  pet            Pet          @relation(fields: [petId], references: [id], onDelete: Restrict)

  @@unique([organizationId, petId, version])
  @@index([organizationId, petId, state])
}

model Equipment {
  id                String       @id @default(uuid())
  organizationId    String
  locationId        String
  name              String
  kind              String
  serialNumber      String?
  state             String
  lastMaintenanceAt DateTime?
  maintenanceNote   String?
  createdAt         DateTime     @default(now())
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  location          Location     @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, serialNumber])
  @@index([organizationId, locationId, state])
}

model PhysicalIdentity {
  id             String       @id @default(uuid())
  organizationId String
  targetType     String
  targetId       String
  opaqueToken    String       @unique
  state          String
  createdAt      DateTime     @default(now())
  revokedAt      DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, targetType, targetId])
  @@index([organizationId, targetType, state])
}

model LabOrder {
  id             String       @id @default(uuid())
  organizationId String
  petId          String
  testName       String
  state          String
  orderedAt      DateTime     @default(now())
  resultSummary  String?
  createdBy      String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  pet            Pet          @relation(fields: [petId], references: [id], onDelete: Restrict)
  specimens      Specimen[]

  @@index([organizationId, petId, orderedAt])
}

model Specimen {
  id                String       @id @default(uuid())
  organizationId    String
  orderId           String
  petId             String
  type              String
  container         String
  state             String
  collectedBy       String
  collectedAt       DateTime
  location          String?
  externalReference String?
  receivedAt        DateTime?
  rejectedReason    String?
  resultLinkedAt    DateTime?
  identityId        String       @unique
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  order             LabOrder     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  pet               Pet          @relation(fields: [petId], references: [id], onDelete: Restrict)

  @@index([organizationId, orderId, state])
}

model Supplier {
  id             String          @id @default(uuid())
  organizationId String
  name           String
  contactEmail   String?
  state          String
  createdAt      DateTime        @default(now())
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  purchaseOrders PurchaseOrder[]

  @@index([organizationId, state])
}

model PurchaseOrder {
  id             String       @id @default(uuid())
  organizationId String
  supplierId     String
  locationId     String
  state          String
  lines          Json
  createdAt      DateTime     @default(now())
  approvedAt     DateTime?
  orderedAt      DateTime?
  receivedAt     DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  supplier       Supplier     @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  @@index([organizationId, locationId, state])
  @@index([supplierId, state])
}

model InventoryItem {
  id                     String          @id @default(uuid())
  organizationId         String
  sku                    String
  name                   String
  itemType               String
  unit                   String
  barcode                String?
  purchasePriceMinor     Int?
  sellPriceMinor         Int?
  lowStockThresholdMilli Int             @default(0)
  storageRequirements    Json            @default("{}")
  active                 Boolean         @default(true)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  organization           Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  lots                   StockLot[]
  movements              StockMovement[]

  @@unique([organizationId, sku])
  @@unique([organizationId, barcode])
  @@index([organizationId, itemType, active])
}

model StockLot {
  id             String          @id @default(uuid())
  organizationId String
  itemId         String
  locationId     String
  lotCode        String
  expiryAt       DateTime?
  quantityMilli  Int
  state          String          @default("ACTIVE")
  storageState   String          @default("AVAILABLE")
  receivedAt     DateTime        @default(now())
  createdBy      String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  item           InventoryItem   @relation(fields: [itemId], references: [id], onDelete: Restrict)
  location       Location        @relation(fields: [locationId], references: [id], onDelete: Restrict)
  movements      StockMovement[]

  @@unique([organizationId, itemId, locationId, lotCode])
  @@index([organizationId, itemId, locationId, expiryAt])
  @@index([organizationId, state, storageState])
}

model StockMovement {
  id                String        @id @default(uuid())
  organizationId    String
  itemId            String
  lotId             String
  locationId        String
  direction         String
  quantityMilli     Int
  balanceAfterMilli Int
  reason            String
  referenceType     String?
  referenceId       String?
  petId             String?
  performedBy       String
  createdAt         DateTime      @default(now())
  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  item              InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  lot               StockLot      @relation(fields: [lotId], references: [id], onDelete: Restrict)
  location          Location      @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@index([organizationId, itemId, locationId, createdAt])
  @@index([organizationId, referenceType, referenceId])
  @@index([organizationId, petId, createdAt])
}

model PrintTemplate {
  id             String              @id @default(uuid())
  organizationId String
  kind           String
  title          String?
  version        Int
  body           String
  contentHash    String?
  state          String
  createdAt      DateTime            @default(now())
  publishedAt    DateTime?
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  jobs           PrintJob[]
  documents      GeneratedDocument[]

  @@unique([organizationId, kind, version])
  @@index([organizationId, kind, state])
}

model GeneratedDocument {
  id              String        @id @default(uuid())
  organizationId  String
  templateId      String
  ownerId         String
  petId           String?
  appointmentId   String?
  caseId          String?
  invoiceId       String?
  kind            String
  title           String
  documentVersion String
  renderedBody    String
  contentHash     String
  idempotencyKey  String?       @unique
  state           String        @default("AWAITING_SIGNATURE")
  createdBy       String
  createdAt       DateTime      @default(now())
  signedAt        DateTime?
  revokedAt       DateTime?
  template        PrintTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  invoice         Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  consent         Consent?

  @@index([organizationId, ownerId, createdAt])
  @@index([organizationId, petId, kind])
  @@index([organizationId, state, createdAt])
}

model PrintJob {
  id             String        @id @default(uuid())
  organizationId String
  templateId     String
  kind           String
  payload        Json
  state          String
  createdAt      DateTime      @default(now())
  externalJobId  String?
  failureReason  String?
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  template       PrintTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)

  @@index([organizationId, state, createdAt])
}

model ChecklistTemplate {
  id             String         @id @default(uuid())
  organizationId String
  purpose        String
  version        Int
  state          String
  steps          Json
  createdAt      DateTime       @default(now())
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  runs           ChecklistRun[]

  @@unique([organizationId, purpose, version])
  @@index([organizationId, purpose, state])
}

model ChecklistRun {
  id             String            @id @default(uuid())
  organizationId String
  templateId     String
  targetType     String
  targetId       String
  state          String
