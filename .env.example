# ============================================================================
# «ОГОНЬ ДУШИ» — пример переменных окружения.
# Скопируйте этот файл в .env и заполните значения. НЕ КОММИТЬТЕ .env.
# ============================================================================

# --- База данных -----------------------------------------------------------
# Локальная разработка (SQLite):
DATABASE_URL="file:./dev.db"
# Production (PostgreSQL) — замените datasource provider в prisma/schema.prisma
# на "postgresql" и укажите строку подключения:
# DATABASE_URL="postgresql://user:password@host:5432/ogon_dushi?schema=public"

# --- Базовый адрес сайта ----------------------------------------------------
# Используется для canonical, sitemap, Open Graph и ссылок в уведомлениях.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Авторизация администратора --------------------------------------------
# Секрет для подписи admin-сессии (cookie). Сгенерируйте случайную строку:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string"
# Сессия действительна (в часах):
AUTH_SESSION_HOURS="12"

# --- Telegram-уведомления о заказах ----------------------------------------
# Токен бота (получить у @BotFather). Оставьте пустым — уведомления отключены,
# но заказы всё равно сохраняются.
TELEGRAM_BOT_TOKEN=""
# ID чата/канала владельца (узнать через @userinfobot или getUpdates):
TELEGRAM_CHAT_ID=""

# --- Email-уведомления (SMTP, опционально) ---------------------------------
# Оставьте пустым — email-канал отключён.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="ОГОНЬ ДУШИ <noreply@example.com>"
ORDER_NOTIFY_EMAIL="OgonDushi13@yandex.ru"

# --- Онлайн-оплата (эквайринг) ---------------------------------------------
# Провайдер: none | yookassa | tinkoff  (по умолчанию none — оплата онлайн выключена)
PAYMENT_PROVIDER="none"
PAYMENT_MERCHANT_ID=""
PAYMENT_SECRET_KEY=""
# Секрет для проверки подписи webhook входящих уведомлений о платеже:
PAYMENT_WEBHOOK_SECRET=""

# --- Карта (2ГИС / внешний провайдер) --------------------------------------
# Оставьте пустым — карта заменяется адресом и кнопкой построения маршрута.
MAP_PROVIDER="none"
NEXT_PUBLIC_MAP_EMBED_URL=""
NEXT_PUBLIC_MAP_ROUTE_URL=""
