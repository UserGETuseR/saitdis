# Файл-образец. Боевые значения живут в /etc/chay-api.env с правами 0600
# и никогда не попадают в Git.

PORT=4410
DATABASE_URL=postgresql://chay_app:replace-me@127.0.0.1:5432/chay
SESSION_DAYS=30
TRUST_PROXY=1

# ——— Обмен с 1С ———
# Пока эти переменные пустые, обмен выключен: события накапливаются в очереди
# chay_integration_outbox и уйдут в 1С после настройки доступа. Ничего не теряется.
ONEC_BASE_URL=
ONEC_USERNAME=
ONEC_PASSWORD=
ONEC_HEALTH_PATH=/hs/chay/health
ONEC_EXCHANGE_PATH=/hs/chay/exchange

# ——— Оповещение чайной о новом заказе ———
# Пока переменные пустые, заказ сохраняется и виден в кабинете,
# но рабочий телефон о нём не сообщает.
#
# Telegram: токен у @BotFather, chat_id — у @userinfobot в нужном чате.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Webhook для телефонного робота или другой системы: POST с JSON заказа.
ORDER_WEBHOOK_URL=
ORDER_WEBHOOK_TOKEN=
